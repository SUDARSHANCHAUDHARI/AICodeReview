{
  "name": "aicodereview",
  "version": "1.0.0",
  "description": "Portable code review workflows for Claude Code, Codex, Cursor, Copilot, Gemini, OpenCode, and Aider",
  "bin": {
    "aicodereview": "bin/aicodereview.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run test:node",
    "test:node": "npm run build && node --test tests/node-cli.test.js",
    "test:shell": "bash tests/run-all.sh",
    "validate": "npm run build && node bin/aicodereview.js validate",
    "generate": "npm run build && node bin/aicodereview.js generate --write",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "ai",
    "code-review",
    "claude",
    "codex",
    "cursor",
    "copilot",
    "gemini",
    "opencode",
    "aider",
    "skills",
    "developer-tools"
  ],
  "author": "SUDARSHANCHAUDHARI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SUDARSHANCHAUDHARI/AICodeReview.git"
  },
  "homepage": "https://github.com/SUDARSHANCHAUDHARI/AICodeReview#readme",
  "bugs": {
    "url": "https://github.com/SUDARSHANCHAUDHARI/AICodeReview/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "aicodereview-lib.sh",
    "install.sh",
    "uninstall.sh",
    "update.sh",
    "list-installed.sh",
    "check-health.sh",
    "scripts/",
    "skills/",
    "templates/",
    "examples/"
  ],
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.8.3"
  }
}
